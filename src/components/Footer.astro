<style>
	footer {
		background: #070707;
		color: var(--text-secondary);
		padding: 0;
		border-top: 1px solid rgba(201, 169, 110, 0.12);
	}

	.footer-main {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 4rem;
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem 3rem;
	}

	/* Brand side */
	.brand-logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1rem;
	}

	.brand-star {
		color: var(--gold);
		font-size: 1.1rem;
	}

	.footer-brand h3 {
		color: var(--text-primary);
		font-size: 1.15rem;
		margin: 0;
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	.footer-brand p {
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0 0 1.25rem 0;
		color: var(--text-muted);
	}

	.trust-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 0.75rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		padding: 0.3rem 0.65rem;
		border-radius: 20px;
		color: var(--text-muted);
		white-space: nowrap;
	}

	.badge svg {
		color: var(--gold);
		flex-shrink: 0;
	}

	/* Links grid */
	.footer-links {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
	}

	.footer-col h4 {
		color: var(--text-primary);
		font-size: 0.8rem;
		font-weight: 700;
		margin: 0 0 1rem 0;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.footer-col a {
		display: block;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.88rem;
		margin-bottom: 0.55rem;
		transition: color 0.2s ease;
	}

	.footer-col a:hover {
		color: var(--gold);
	}

	/* Social icons row */
	.social-row {
		display: flex;
		gap: 0.6rem;
		margin-top: 0.75rem;
	}

	.social-icon-link {
		display: flex !important;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--text-muted) !important;
		transition: all 0.2s ease;
		padding: 0 !important;
	}

	.social-icon-link:hover {
		background: var(--gold-subtle);
		border-color: var(--gold);
		color: var(--gold) !important;
		transform: translateY(-2px);
	}

	/* Bottom bar */
	.footer-bottom {
		border-top: 1px solid var(--border);
		padding: 1.5rem;
		text-align: center;
		max-width: 1200px;
		margin: 0 auto;
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	.footer-note {
		margin-top: 0.4rem !important;
		font-size: 0.78rem !important;
		letter-spacing: 0.02em;
	}

	.footer-note span {
		font-size: 0.9rem;
	}

	/* Responsive */
	@media (max-width: 960px) {
		.footer-main { grid-template-columns: 1fr; gap: 2.5rem; }
		.footer-links { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 500px) {
		.footer-links { grid-template-columns: 1fr 1fr; }
	}
</style>
