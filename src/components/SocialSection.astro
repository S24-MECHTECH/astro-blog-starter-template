<style>
  .social {
    padding: 90px 30px;
    background: var(--bg-base);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .social-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .title-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--gold);
    margin-bottom: 14px;
    padding: 5px 16px;
    border: 1px solid var(--border-gold);
    border-radius: 20px;
    background: var(--gold-subtle);
  }

  .social h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 44px 0;
    letter-spacing: -0.01em;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 36px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 15px;
    transition: all 0.3s ease;
    min-width: 180px;
    justify-content: center;
  }

  .social-link:hover {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-subtle);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(201, 169, 110, 0.2);
  }

  .social-link svg {
    flex-shrink: 0;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .social-link:hover svg {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .social { padding: 60px 20px; }
    .social-link { min-width: 150px; padding: 14px 24px; }
  }
</style>
