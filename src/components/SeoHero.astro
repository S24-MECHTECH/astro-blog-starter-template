---
import type { WebflowItem } from '../lib/webflow';

interface Props {
  item: WebflowItem;
}

const { item } = Astro.props;
const heroHeading = item.heroHeading || item.name;
const heroSubheading = item.heroSubheading || item.description;
const heroCtaText = item.heroCtaText || 'Mehr erfahren';
const heroCtaUrl = item.heroCtaUrl || 'https://www.siliconedolls24.com';
---

<section class="hero">
  <div class="hero-glow hero-glow-left"></div>
  <div class="hero-glow hero-glow-right"></div>
  <div class="hero-content">
    <div class="hero-badge">
      <span class="badge-star">&#10022;</span>
      <span>Made in Germany</span>
    </div>
    <h1 class="hero-h1">{heroHeading}</h1>
    <p class="hero-subtitle">{heroSubheading}</p>
    <a href={heroCtaUrl} class="hero-cta">
      {heroCtaText}
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <div class="hero-stats">
      <div class="stat">
        <div class="stat-number">10+</div>
        <div class="stat-label">Jahre Erfahrung</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <div class="stat-number">500+</div>
        <div class="stat-label">Kunden</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <div class="stat-number">50+</div>
        <div class="stat-label">Modelle</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <div class="stat-number">4.9</div>
        <div class="stat-label">Bewertung</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 100px 30px;
    background: var(--bg-base);
    overflow: hidden;
  }

  /* Ambient glows */
  .hero-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
  }
  .hero-glow-left {
    top: -100px;
    left: -200px;
    background: radial-gradient(circle, rgba(201, 169, 110, 0.08) 0%, transparent 70%);
  }
  .hero-glow-right {
    bottom: -100px;
    right: -200px;
    background: radial-gradient(circle, rgba(201, 169, 110, 0.05) 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    max-width: 860px;
    z-index: 1;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: var(--gold-glow);
    border: 1px solid var(--border-gold);
    border-radius: 30px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--gold);
    margin-bottom: 28px;
  }

  .badge-star {
    color: var(--gold);
    font-size: 10px;
  }

  /* Headline */
  .hero-h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.08;
    color: var(--text-primary);
    margin: 0 0 24px 0;
    letter-spacing: -0.01em;
  }

  /* Subtitle */
  .hero-subtitle {
    font-size: clamp(16px, 2vw, 20px);
    color: var(--text-secondary);
    margin: 0 0 44px 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
  }

  /* CTA Button */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 46px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
    color: #080808;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 24px rgba(201, 169, 110, 0.3);
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(201, 169, 110, 0.5);
    background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold) 100%);
    color: #080808;
  }

  /* Stats row */
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-top: 72px;
    padding-top: 44px;
    border-top: 1px solid var(--border);
  }

  .stat {
    text-align: center;
    padding: 0 40px;
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background: var(--border);
    flex-shrink: 0;
  }

  .stat-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 42px;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 70px 20px;
    }
    .hero-stats {
      gap: 0;
      flex-wrap: wrap;
      margin-top: 50px;
      padding-top: 32px;
    }
    .stat {
      padding: 16px 20px;
    }
    .stat-divider {
      display: none;
    }
    .stat-number {
      font-size: 32px;
    }
  }
</style>
