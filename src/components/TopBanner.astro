---
// Top Announcement Bar
---
<div class="top-banner">
	<div class="banner-container">
		<span class="banner-item">💎 SILICONEDOLLS24.COM</span>
		<span class="banner-divider">|</span>
		<span class="banner-item">⭐ DREAMDOLL.DE</span>
		<span class="banner-divider">|</span>
		<span class="banner-item">💎 PREMIUM QUALITÄT</span>
		<span class="banner-divider">|</span>
		<span class="banner-item">🇩🇪 DEUTSCHLAND</span>
	</div>
</div>

<style>
	.top-banner {
		background: linear-gradient(90deg, #1a1a2e 0%, #16213e 50%, #1a1a2e 100%);
		color: white;
		padding: 0.5rem 1rem;
		text-align: center;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.05em;
	}
	.banner-container {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
	}
	.banner-item {
		white-space: nowrap;
	}
	.banner-divider {
		color: rgba(255,255,255,0.3);
	}
	@media (max-width: 600px) {
		.banner-divider { display: none; }
	}
</style>
