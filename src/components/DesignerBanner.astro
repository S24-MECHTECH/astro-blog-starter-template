---
interface Props {
  headline?: string;
  subline?: string;
}
const {
  headline = 'Premium Silikonpuppe 2025',
  subline = 'Entdecken Sie unsere exklusive Kollektion'
} = Astro.props;
---

<section class="designer-banner">
  <div class="banner-inner">
    <span class="banner-star" aria-hidden="true">&#10022;</span>
    <h2 class="banner-headline">{headline}</h2>
    <span class="banner-star" aria-hidden="true">&#10022;</span>
  </div>
  {subline && <p class="banner-subline">{subline}</p>}
</section>

<style>
  .designer-banner {
    background: linear-gradient(90deg, #0a0a0a, #111111, #0a0a0a);
    color: var(--text-primary);
    padding: 3rem 1.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(201, 169, 110, 0.12);
    border-bottom: 1px solid rgba(201, 169, 110, 0.12);
  }

  .designer-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(201, 169, 110, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 50%, rgba(201, 169, 110, 0.04) 0%, transparent 50%);
    pointer-events: none;
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .banner-star {
    color: var(--gold);
    font-size: 1.2rem;
    opacity: 0.7;
    animation: pulse-star 3s ease-in-out infinite;
  }

  .banner-star:last-child {
    animation-delay: 1.5s;
  }

  @keyframes pulse-star {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  .banner-headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.4rem, 3.5vw, 2.4rem);
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
    letter-spacing: 0.01em;
    background: linear-gradient(90deg, var(--gold-light), var(--gold), var(--gold-light));
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 4s linear infinite;
  }

  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  .banner-subline {
    margin: 0.9rem 0 0 0;
    font-size: 1rem;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 600px) {
    .designer-banner { padding: 2rem 1rem; }
    .banner-headline { font-size: 1.3rem; }
    .banner-star { display: none; }
  }
</style>
