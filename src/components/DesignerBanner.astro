---
interface Props {
  headline?: string;
  subline?: string;
}
const {
  headline = 'Premium Silikonpuppe 2025',
  subline = 'Entdecken Sie unsere exklusive Kollektion'
} = Astro.props;
---

<section class="designer-banner">
	<div class="banner-inner">
		<span class="banner-tag">✦</span>
		<h2 class="banner-headline">{headline}</h2>
		<span class="banner-tag">✦</span>
	</div>
	{subline ? <p class="banner-subline">{subline}</p> : null}
</section>

<style>
	.designer-banner {
		background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #16213e 100%);
		color: white;
		padding: 2rem 1.5rem;
		text-align: center;
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid rgba(233, 69, 96, 0.3);
	}
	.designer-banner::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at 20% 50%, rgba(233, 69, 96, 0.08) 0%, transparent 60%),
			radial-gradient(ellipse at 80% 50%, rgba(255, 255, 255, 0.04) 0%, transparent 60%);
		pointer-events: none;
	}
	.banner-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
		max-width: 900px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}
	.banner-tag {
		color: #e94560;
		font-size: 1.2rem;
		opacity: 0.8;
	}
	.banner-headline {
		font-size: clamp(1.4rem, 3.5vw, 2.2rem);
		font-weight: 800;
		margin: 0;
		color: white;
		letter-spacing: 0.02em;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
	}
	.banner-subline {
		margin: 0.75rem 0 0 0;
		font-size: 1rem;
		color: rgba(255, 255, 255, 0.75);
		letter-spacing: 0.04em;
		position: relative;
		z-index: 1;
	}
	@media (max-width: 600px) {
		.designer-banner { padding: 1.5rem 1rem; }
		.banner-headline { font-size: 1.3rem; }
	}
</style>
