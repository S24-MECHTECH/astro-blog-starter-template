---
// Features Section — Dark Card Grid, Gold Icon Accents, Hover
const features = [
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect x="9" y="11" width="14" height="10" rx="2"/><path d="M5 17h14v2H5z"/><path d="M12 17v4"/></svg>`,
    title: 'Schnelle Lieferung',
    desc: 'Diskrete und schnelle Lieferung innerhalb von 2-4 Werktagen'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2"/><path d="M1 10h22"/><path d="M10 6h4a2 2 0 0 1 0 4h-4"/><circle cx="12" cy="14" r="2"/></svg>`,
    title: 'Diskret Verpackt',
    desc: 'Neutraler Versand in unauffälliger Verpackung - niemand erfährt davon'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/></svg>`,
    title: 'Premium Qualität',
    desc: 'Hochwertige Materialien und erstklassige Verarbeitung aus Deutschland'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1" fill="currentColor"/></svg>`,
    title: 'SSL Verschlüsselt',
    desc: 'Ihre Daten sind bei uns sicher und geschützt'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/><path d="M12 6v6l4 2"/></svg>`,
    title: 'Top Bewertungen',
    desc: 'Über 500 zufriedene Kunden bewerten uns mit 4.9/5 Sternen'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: 'Deutsche Marke',
    desc: 'Deutsches Qualitätssiegel und deutscher Kundenservice'
  },
];
---

<section class="features">
  <div class="features-inner">
    <div class="section-title">
      <span class="title-eyebrow">Unsere Stärken</span>
      <h2>Warum wir?</h2>
      <p>Entdecken Sie die Vorteile, die uns von anderen unterscheiden</p>
    </div>
    <div class="features-grid">
      {features.map((feature, i) => (
        <div class="feature-card" style={`--delay: ${i * 80}ms`}>
          <div class="feature-icon" set:html={feature.icon}></div>
          <h3>{feature.title}</h3>
          <p>{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 100px 30px;
    background: var(--bg-base);
    position: relative;
    overflow: hidden;
  }

  .features::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.3), transparent);
  }

  .features-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    margin-bottom: 60px;
  }

  .title-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: var(--gold);
    margin-bottom: 14px;
    padding: 5px 16px;
    border: 1px solid var(--border-gold);
    border-radius: 20px;
    background: var(--gold-subtle);
  }

  .section-title h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 16px 0;
    letter-spacing: -0.01em;
  }

  .section-title p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    background: var(--bg-card);
    padding: 36px 28px;
    border-radius: 16px;
    text-align: center;
    border: 1px solid var(--border);
    transition: all 0.35s ease;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    transition: width 0.4s ease;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    border-color: rgba(201, 169, 110, 0.3);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(201, 169, 110, 0.1);
  }

  .feature-card:hover::before {
    width: 60%;
  }

  .feature-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gold-subtle);
    border: 1px solid rgba(201, 169, 110, 0.2);
    border-radius: 18px;
    color: var(--gold);
    transition: all 0.35s ease;
  }

  .feature-card:hover .feature-icon {
    background: rgba(201, 169, 110, 0.15);
    border-color: rgba(201, 169, 110, 0.4);
    transform: scale(1.08);
  }

  .feature-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 10px 0;
    letter-spacing: -0.01em;
  }

  .feature-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 960px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .features { padding: 70px 20px; }
    .features-grid { grid-template-columns: 1fr; gap: 16px; }
    .feature-card { padding: 28px 20px; }
  }
</style>
