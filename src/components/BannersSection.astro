---
import type { WebflowItem } from '../lib/webflow';

interface Props {
  item: WebflowItem;
}

const { item } = Astro.props;
const bannerImage = item.heroBanner || item.bannerImage || 'https://www.siliconedolls24.com/img/banner.jpg';
const bannerUrl = item.heroCtaUrl || item.bannerUrl || 'https://www.siliconedolls24.com';
---

<section class="banners-section">
  <div class="banners">
    <a href={bannerUrl} class="banner-link" target="_blank" rel="noopener">
      <div class="banner-overlay"></div>
      <img
        src={bannerImage}
        alt="Premium Silikonpuppen"
        class="banner-img"
        loading="lazy"
      />
    </a>
    <a href={bannerUrl} class="banner-link" target="_blank" rel="noopener">
      <div class="banner-overlay"></div>
      <img
        src={bannerImage}
        alt="Silikonpuppen Shop"
        class="banner-img"
        loading="lazy"
      />
    </a>
    <a href={bannerUrl} class="banner-link" target="_blank" rel="noopener">
      <div class="banner-overlay"></div>
      <img
        src={bannerImage}
        alt="Liebespuppen Deutschland"
        class="banner-img"
        loading="lazy"
      />
    </a>
  </div>
</section>

<style>
  .banners-section {
    background: var(--bg-base);
    padding: 0;
  }

  .banners {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--border);
  }

  .banner-link {
    display: block;
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(8, 8, 8, 0.6) 100%
    );
    z-index: 1;
    transition: opacity 0.4s ease;
  }

  .banner-link:hover .banner-overlay {
    opacity: 0.7;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    max-height: 320px;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
    min-height: 220px;
  }

  .banner-link:hover .banner-img {
    transform: scale(1.04);
  }

  @media (max-width: 900px) {
    .banners {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .banner-img {
      max-height: 220px;
    }
  }
</style>
